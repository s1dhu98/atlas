# Atlas production env. Copy to .env.production and fill in.
# Do NOT commit .env.production — it's in .gitignore.

# ----------------------------------------------------------------------------
# SOURCE_DATABASE_URL — the operational LabStack DB.
# Read-only for Atlas. On a Linux VM with Postgres on the host, use
# host.docker.internal:5432 (the docker-compose extra_hosts mapping handles
# the Linux gateway routing automatically).
#
# Create a read-only role on the source DB:
#   CREATE ROLE atlas_reader LOGIN PASSWORD '<strong-pw>';
#   GRANT CONNECT ON DATABASE labstack TO atlas_reader;
#   GRANT USAGE ON SCHEMA public TO atlas_reader;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO atlas_reader;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT ON TABLES TO atlas_reader;
# ----------------------------------------------------------------------------
SOURCE_DATABASE_URL=postgresql://atlas_reader:CHANGEME@host.docker.internal:5432/labstack

# ----------------------------------------------------------------------------
# APP_DATABASE_URL — Atlas's own DB, hosted by the atlas-db service in this
# docker-compose stack.
# Default works out of the box; only set this explicitly if you want
# atlas-web to point at a managed Postgres instead.
# ----------------------------------------------------------------------------
# APP_DATABASE_URL=postgres://atlas:atlas@atlas-db:5432/atlas

# ----------------------------------------------------------------------------
# ATLAS_DB_PASSWORD — Postgres password for the atlas-db container.
# Used by both the Postgres init and the default APP_DATABASE_URL above.
# Change before exposing the host's 5433 port to anything you don't trust.
# ----------------------------------------------------------------------------
ATLAS_DB_PASSWORD=atlas

# ----------------------------------------------------------------------------
# APP_URL — public origin Atlas is served at. Used for absolute redirect URLs
# (e.g. on logout). Include scheme; no trailing slash.
# ----------------------------------------------------------------------------
APP_URL=https://atlas.your-domain.example

# ----------------------------------------------------------------------------
# DISCOVERY — finding labs in pincodes the network cannot reach.
#
# Off by default, and off means off: nothing claims a pincode, nothing reaches
# any API, nothing is billed and nothing is written. The button refuses, the
# batch script exits, the real probe refuses. Leads found by earlier searches
# stay listed and stay callable. Nothing is deleted.
#
#   npm run labs:status      is it configured — free, works while off
#   npm run labs:estimate    what a sweep would cost — free, works while off
# ----------------------------------------------------------------------------
DISCOVERY_ENABLED=false

# Sources to try, in order, until MIN_LEADS is reached. The first one that
# answers ends the walk, so a pincode a free Indian directory can serve never
# reaches a metered provider.
#
# Order is not arbitrary. Mappls and Ola are Indian directories of Indian
# businesses with better small-town coverage than a global provider, they are
# free or nearly so at this volume, and their terms do not restrict keeping a
# name, address and phone — which matters, because promoting a lead into CRM is
# exactly that. Google has the best coverage and the only ratings, and the
# tightest retention terms, so it fills gaps rather than leading.
#
# 'llm' is the original path: a model reading the open web, about $1.50 a
# pincode against roughly $0.03 for a places API. Leave it out of the chain
# unless you want a floor under the directories for the thinnest pincodes, and
# even then it stays capped by DISCOVERY_MAX_LLM_CALLS below.
DISCOVERY_PROVIDERS=mappls,ola,google

# Stop walking the chain once a pincode has this many usable leads.
DISCOVERY_MIN_LEADS=2
# Drop anything the ranking layer scores below this (0–1).
DISCOVERY_MIN_SCORE=0.25
# How far from the pincode centroid a place may be and still be offered.
DISCOVERY_RADIUS_M=6000
# Hard ceiling on one batch run, USD. The sweep stops rather than overspend.
DISCOVERY_BUDGET_USD=15
# Model calls allowed per run. Zero means the model path never runs, even if
# 'llm' is in the chain. Raise it deliberately, knowing the per-call price.
DISCOVERY_MAX_LLM_CALLS=0
# Whether the in-app button may use one of those calls. Separate on purpose: a
# nightly sweep spending on a stranded pincode is a decision somebody made; a
# click doing the same silently is not.
DISCOVERY_LLM_IN_APP=false

# Credentials. A provider with no credential is skipped, not failed — the chain
# moves on and `npm run labs:status` says which ones are missing.
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=
OLA_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# Cost per pincode, USD. Estimates, so they are overridable rather than
# compiled in as facts — the ledger and the estimate both read these, and a
# stale number here under-reports what discovery is costing.
# DISCOVERY_COST_MAPPLS_USD=0
# DISCOVERY_COST_OLA_USD=0.002
# DISCOVERY_COST_GOOGLE_USD=0.035
# DISCOVERY_COST_LLM_USD=1.50
